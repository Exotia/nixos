#!/usr/bin/env bash

# Toggles the window gaps globally between no gaps and the default 10/5/2.

hyprctl eval '
if hl.get_config("general.gaps_out").top == 0 then
  hl.config({ ["general.gaps_out"] = 10, ["general.gaps_in"] = 5, ["general.border_size"] = 2 })
else
  hl.config({ ["general.gaps_out"] = 0, ["general.gaps_in"] = 0, ["general.border_size"] = 0 })
end'
