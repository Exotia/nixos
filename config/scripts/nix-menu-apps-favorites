#!/usr/bin/env python3
import os
import json
import subprocess
import re
import shlex

# FALLBACK CONFIG: Define your favorite apps here by their .desktop file IDs
FAVORITES = [
    "com.brave.Browser.desktop",
    "Alacritty.desktop",
    "pcmanfm.desktop",
    "code.desktop",
    "spotify.desktop",
    "com.github.xeco23.WasIstLos.desktop",
    "obsidian.desktop",
    "vesktop.desktop",
    "github.desktop",
    "LocalSend.desktop"
]

CONFIG_PATH = os.path.expanduser("~/nixos-dotfiles/config/fuzzel/custom-launcher.json")
DESKTOP_DIRS = [
    os.path.expanduser("~/.local/share/applications"),
    "/etc/profiles/per-user/ole/share/applications",
    "/run/current-system/sw/share/applications"
]

def load_config():
    try:
        with open(CONFIG_PATH, "r") as f:
            return json.load(f)
    except Exception:
        return {"aliases": {}, "icons": {}, "defaults": []}

def get_desktop_files():
    apps = {}
    for d in DESKTOP_DIRS:
        if os.path.exists(d):
            for f in os.listdir(d):
                if f.endswith(".desktop") and f not in apps:
                    apps[f] = os.path.join(d, f)
    return apps

def parse_desktop_file(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
        data = {}
        in_entry = False
        for line in content.splitlines():
            line = line.strip()
            if line == "[Desktop Entry]": in_entry = True
            elif line.startswith("["): in_entry = False
            elif in_entry and "=" in line:
                k, v = line.split("=", 1)
                data[k.strip()] = v.strip()
        return {
            "name": data.get("Name", ""),
            "exec": re.sub(r"%[fFuUikInNvV]", "", data.get("Exec", "")).strip(),
            "icon": data.get("Icon", "application-x-executable"),
            "terminal": data.get("Terminal") == "true"
        }
    except: return None

def main():
    config = load_config()
    aliases = config.get("aliases", {})
    icons = config.get("icons", {})
    defaults = config.get("defaults", [])
    config_dir = os.path.dirname(CONFIG_PATH)
    
    # Use defaults from JSON if available, otherwise fallback to hardcoded list
    favorites_list = defaults if defaults else FAVORITES
    
    desktop_files = get_desktop_files()
    lines = []
    seen_names = set() # To deduplicate by display name
    
    for df_id in favorites_list:
        if df_id in desktop_files:
            app = parse_desktop_file(desktop_files[df_id])
            if not app: continue
            
            name = aliases.get(df_id, app["name"])
            if name in seen_names:
                continue
            seen_names.add(name)
            
            icon = icons.get(df_id, app["icon"])
            if icon.startswith("./") or icon.startswith("../"):
                icon = os.path.normpath(os.path.join(config_dir, icon))
                
            lines.append(f"{name}\t{app['exec']}\t{app['terminal']}\0icon\x1f{icon}")

    if not lines:
        print("No favorites found.")
        return

    fuzzel_input = "\n".join(lines)
    
    try:
        res = subprocess.run(
            ["fuzzel", "--dmenu", "--with-nth=1", "--accept-nth={2}\t{3}", "--nth-delimiter=\t", "-p", "", "--placeholder", "Favorites…", "--width", "30"],
            input=fuzzel_input.encode("utf-8"),
            capture_output=True,
            check=True
        )
        
        output = res.stdout.decode("utf-8").strip()
        if output:
            parts = output.split("\t")
            cmd = parts[0]
            terminal = (len(parts) > 1 and parts[1] == "True")
            
            if terminal:
                os.execvp("uwsm-app", ["uwsm-app", "--", "xdg-terminal-exec"] + shlex.split(cmd))
            else:
                os.execvp("uwsm-app", ["uwsm-app", "--"] + shlex.split(cmd))
    except: pass

if __name__ == "__main__":
    main()
