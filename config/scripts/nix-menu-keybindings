#!/usr/bin/env bash

# Displays a comprehensive list of Hyprland keyboard shortcuts in a Fuzzel menu.

LIST="🚀 APPLICATION LAUNCHERS
SUPER + SPACE       ➜  Favorites menu
SUPER + A           ➜  App Launcher
SUPER + RETURN      ➜  Terminal (at current directory)
SUPER + T           ➜  Terminal
SUPER + SHIFT + RET ➜  Brave Browser
SUPER + ALT + RET   ➜  Brave Browser (Incognito)
SUPER + F           ➜  File Manager (PCManFM)
SUPER + ALT + F     ➜  File Manager (at terminal dir)
SUPER + S           ➜  Launch or Focus Spotify
SUPER + O           ➜  Launch or Focus Obsidian
SUPER + Y           ➜  YouTube (Web App)

🪟 WINDOW MANAGEMENT
SUPER + W           ➜  Close active window
CTRL + ALT + DEL    ➜  Close all windows
SUPER + ARROWS      ➜  Move focus
ALT + TAB           ➜  Cycle applications
SUPER + SHIFT + T   ➜  Toggle Floating
SUPER + SHIFT + F   ➜  Toggle Fullscreen
SUPER + SHIFT + J   ➜  Toggle Split
SUPER + ALT + ARRS  ➜  Resize window
SUPER + SHIFT + G   ➜  Toggle Window Groups
SUPER + [1-0]       ➜  Switch to Workspace
SUPER + SHIFT + [1-0] ➜  Move window to Workspace

🛠️ SYSTEM UTILITIES
SUPER + SHIFT + S   ➜  Screenshot
SUPER + CTRL + L    ➜  Lock Screen
SUPER + CTRL + SPCE ➜  Keybindings menu
SUPER + CTRL + T    ➜  System Monitor (btop)
SUPER + CTRL + A    ➜  Audio Mixer (pulsemixer)
SUPER + CTRL + W    ➜  Network Manager (nmtui)
SUPER + CTRL + I    ➜  Toggle Idle (prevent sleep)
SUPER + SHIFT + SPCE ➜  Toggle Status Bar (Waybar)

📋 CLIPBOARD & NOTIFS
SUPER + C / V / X   ➜  Copy / Paste / Cut
SUPER + CTRL + V    ➜  Clipboard History
SUPER + COMMA       ➜  Dismiss notification
SUPER + SHIFT + COMMA ➜  Dismiss all notifications
SUPER + CTRL + COMMA ➜  Do Not Disturb (Silence)

🎵 MEDIA & HARDWARE
Audio Keys          ➜  Control Volume & Mute
Brightness Keys     ➜  Monitor & Keyboard Backlight
Media Keys          ➜  Play / Pause / Skip

⚡ POWER ACTIONS
󰌾  Lock            ➜  Lock the session
󰍃  Logout          ➜  Exit Hyprland
󰜉  Reboot          ➜  Restart the computer
⏻  Shutdown        ➜  Power off the computer"

# Show the menu
CHOICE=$(echo "$LIST" | fuzzel --dmenu -p "" --placeholder "Shortcuts & System…" --width 100)

# If a power action is selected, execute it
case "$CHOICE" in
    *Lock*)
        "$HOME/nixos-dotfiles/config/scripts/nix-lock-screen"
        ;;
    *Logout*)
        hyprctl dispatch exit
        ;;
    *Reboot*)
        systemctl reboot
        ;;
    *Shutdown*)
        systemctl poweroff
        ;;
esac
