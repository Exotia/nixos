#!/usr/bin/env bash

# Switches to a specific theme and updates all templated configs.

THEME="$1"
THEMES_DIR="$HOME/nixos-dotfiles/config/themes"
THEME_LINK="$HOME/nixos-dotfiles/config/theme"

if [[ -z $THEME ]]; then
  echo "Usage: nix-theme-set <theme-name>" >&2
  exit 1
fi

if [[ ! -d "$THEMES_DIR/$THEME" ]]; then
  echo "Error: Theme '$THEME' not found in $THEMES_DIR" >&2
  exit 1
fi

# Update symlink using absolute path for reliability
ln -nsf "$THEMES_DIR/$THEME" "$THEME_LINK"
echo "Switched to theme: $THEME"

# Update templated configs
"$HOME/nixos-dotfiles/config/scripts/nix-theme-update"

# Automatically apply the first background from the new theme's mutable source
THEME_BACKGROUNDS_DIR="$THEMES_DIR/$THEME/backgrounds"
if [[ -d "$THEME_BACKGROUNDS_DIR" ]]; then
    # Find first background image
    FIRST_BG=$(find "$THEME_BACKGROUNDS_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) | sort | head -1)
    if [[ -n "$FIRST_BG" ]]; then
        "$HOME/nixos-dotfiles/config/scripts/nix-theme-bg-set" "$FIRST_BG"
    fi
fi
