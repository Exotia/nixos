[main]
font=JetBrainsMono Nerd Font:size=12
prompt="❯ "
icon-theme=Papirus-Dark
width=30
horizontal-pad=20
vertical-pad=20
inner-pad=10
line-height=20
letter-spacing=0
layer=overlay
exit-on-keyboard-focus-loss=yes

[colors]
background={{ background_strip }}ff
text={{ foreground_strip }}ff
match={{ accent_strip }}ff
selection={{ selection_background_strip }}ff
selection-text={{ selection_foreground_strip }}ff
border={{ accent_strip }}ff

[border]
width=2
radius=10
