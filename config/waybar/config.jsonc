{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 40,
    "modules-left": [
        "custom/menu",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "custom/weather",
        "clock#time",
        "clock#date"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "tray",
        "custom/notifications",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "①",
            "2": "②",
            "3": "③",
            "4": "④",
            "5": "⑤",
            "6": "⑥",
            "7": "⑦",
            "8": "⑧",
            "9": "⑨",
            "10": "⑩",
            "active": "",
            "default": ""
        },
        "sort-by-number": true
    },
    "custom/menu": {
        "format": "",
        "on-click": "$HOME/nixos-dotfiles/config/scripts/nix-menu-theming",
        "tooltip": false
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 30,
        "separate-outputs": true
    },
    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 3600,
        "exec": "$HOME/nixos-dotfiles/config/scripts/nix-weather-get",
        "return-type": "json",
        "on-click": "uwsm-app -- brave --app=https://wttr.in"
    },
    "cpu": {
        "interval": 10,
        "format": " {usage}%"
    },
    "memory": {
        "interval": 30,
        "format": " {used:0.1f}G"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "clock#date": {
        "format": " {:%d. %B}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "$HOME/nixos-dotfiles/config/scripts/nix-launch-calendar"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "alacritty -e nmtui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["", "", ""],
        "on-click": "alacritty -e pulsemixer"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/notifications": {
        "format": "󰂚",
        "on-click": "nix-toggle-notification-silencing",
        "tooltip": false
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "$HOME/nixos-dotfiles/config/scripts/nix-menu-system",
        "tooltip": false
    }
}
